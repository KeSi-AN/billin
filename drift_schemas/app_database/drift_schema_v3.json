  "fixed_sql": [
    {
      "name": "shop_profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shop_profiles\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"name\" TEXT NOT NULL, \"phone\" TEXT NULL, \"address_line\" TEXT NULL, \"city\" TEXT NULL, \"pincode\" TEXT NULL, \"state_code\" TEXT NOT NULL, \"gstin\" TEXT NULL, \"logo_path\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"parent_id\" INTEGER NULL REFERENCES categories (id));"
        }
      ]
    },
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"barcode\" TEXT NULL UNIQUE, \"unit\" TEXT NOT NULL DEFAULT 'pcs', \"sale_price_paise\" INTEGER NOT NULL, \"mrp_paise\" INTEGER NULL, \"tax_rate_bp\" INTEGER NOT NULL DEFAULT 0, \"price_includes_tax\" INTEGER NOT NULL DEFAULT 1 CHECK (\"price_includes_tax\" IN (0, 1)), \"hsn\" TEXT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"track_stock\" INTEGER NOT NULL DEFAULT 0 CHECK (\"track_stock\" IN (0, 1)), \"stock_milli\" INTEGER NOT NULL DEFAULT 0, \"low_stock_milli\" INTEGER NULL, \"category_id\" INTEGER NULL REFERENCES categories (id), \"image_path\" TEXT NULL, \"tracks_batches\" INTEGER NOT NULL DEFAULT 0 CHECK (\"tracks_batches\" IN (0, 1)), \"alt_unit\" TEXT NULL, \"alt_unit_factor_milli\" INTEGER NULL, \"alt_unit_price_paise\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "bills",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bills\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"invoice_no\" TEXT NOT NULL UNIQUE, \"fy_start\" INTEGER NOT NULL, \"sequence\" INTEGER NOT NULL, \"billed_at\" INTEGER NOT NULL, \"customer_name\" TEXT NULL, \"customer_phone\" TEXT NULL, \"items_total_paise\" INTEGER NOT NULL, \"bill_discount_paise\" INTEGER NOT NULL, \"taxable_paise\" INTEGER NOT NULL, \"tax_paise\" INTEGER NOT NULL, \"round_off_paise\" INTEGER NOT NULL, \"grand_total_paise\" INTEGER NOT NULL, \"payment_mode\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'completed', \"cancelled_at\" INTEGER NULL, \"cancel_reason\" TEXT NULL, UNIQUE (\"fy_start\", \"sequence\"));"
        }
      ]
    },
    {
      "name": "bill_lines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bill_lines\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"bill_id\" INTEGER NOT NULL REFERENCES bills (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"item_id\" INTEGER NULL REFERENCES items (id), \"name\" TEXT NOT NULL, \"unit\" TEXT NOT NULL, \"hsn\" TEXT NULL, \"quantity_milli\" INTEGER NOT NULL, \"unit_price_paise\" INTEGER NOT NULL, \"tax_rate_bp\" INTEGER NOT NULL, \"price_includes_tax\" INTEGER NOT NULL CHECK (\"price_includes_tax\" IN (0, 1)), \"discount_paise\" INTEGER NOT NULL, \"bill_discount_share_paise\" INTEGER NOT NULL, \"taxable_paise\" INTEGER NOT NULL, \"tax_paise\" INTEGER NOT NULL, \"total_paise\" INTEGER NOT NULL, \"unit_factor_milli\" INTEGER NOT NULL DEFAULT 1000);"
        }
      ]
    },
    {
      "name": "invoice_counters",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoice_counters\" (\"fy_start\" INTEGER NOT NULL, \"last_sequence\" INTEGER NOT NULL, PRIMARY KEY (\"fy_start\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"invoice_prefix\" TEXT NOT NULL DEFAULT 'INV', \"round_to_rupee\" INTEGER NOT NULL DEFAULT 1 CHECK (\"round_to_rupee\" IN (0, 1)), \"upi_id\" TEXT NULL, \"receipt_footer\" TEXT NULL, \"printer_address\" TEXT NULL, \"printer_name\" TEXT NULL, \"paper_width_mm\" INTEGER NOT NULL DEFAULT 58, PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "item_batches",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"item_batches\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"item_id\" INTEGER NOT NULL REFERENCES items (id), \"batch_no\" TEXT NOT NULL, \"expiry\" INTEGER NULL, \"quantity_milli\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL, UNIQUE (\"item_id\", \"batch_no\"));"
        }
      ]
    },
    {
      "name": "stock_movements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stock_movements\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"item_id\" INTEGER NOT NULL REFERENCES items (id), \"batch_id\" INTEGER NULL REFERENCES item_batches (id), \"quantity_milli\" INTEGER NOT NULL, \"type\" TEXT NOT NULL, \"note\" TEXT NULL, \"bill_id\" INTEGER NULL REFERENCES bills (id), \"balance_after_milli\" INTEGER NOT NULL, \"at\" INTEGER NOT NULL);"
        }
      ]
    },
