<?xml version="1.0" encoding="utf-8"?>
<!-- App icon: a generic shop front (awning, window, door). Drawn on the
     adaptive-icon canvas (108 x 108) and scaled so every corner stays in
     the 66 dp safe zone that round launcher masks keep. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.86"
        android:scaleY="0.86">
        <!-- roof bar -->
        <path android:fillColor="#FFFFFF" android:pathData="M30,30 h48 a2,2 0 0,1 2,2 v2.5 h-52 v-2.5 a2,2 0 0,1 2,-2 z" />
        <!-- awning -->
        <path android:fillColor="#FFFFFF" android:pathData="M30,34 h8 v9 a4,4 0 0,1 -8,0 z M46,34 h8 v9 a4,4 0 0,1 -8,0 z M62,34 h8 v9 a4,4 0 0,1 -8,0 z" />
        <path android:fillColor="#FFFFFF" android:fillAlpha="0.7" android:pathData="M38,34 h8 v9 a4,4 0 0,1 -8,0 z M54,34 h8 v9 a4,4 0 0,1 -8,0 z M70,34 h8 v9 a4,4 0 0,1 -8,0 z" />
        <!-- shop front with a window and a door cut out -->
        <path android:fillColor="#FFFFFF" android:fillType="evenOdd"
            android:pathData="M33,49 h42 v27 a2,2 0 0,1 -2,2 h-38 a2,2 0 0,1 -2,-2 z
                              M40,56 h11 v10 h-11 z
                              M56,57 h11 v21 h-11 z" />
    </group>
</vector>
